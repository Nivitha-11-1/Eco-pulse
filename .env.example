# EcoPulse Environment Configuration Template
# Copy this file to '.env' and fill in your values.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000

# Database Configuration
DATABASE_PATH=data/news.db

# Demo Mode Setting
# Set to 'true' to use sample local articles when offline or testing without internet
DEMO_MODE=true

# AI Service Settings
# Options: gemini, openai, mock
AI_PROVIDER=gemini
GEMINI_API_KEY=your_api_key_here
AI_API_KEY=your_api_key_here

# Scheduler Settings (24-hour format or interval in hours)
DAILY_RUN_TIME=06:00
SCHEDULE_INTERVAL_HOURS=24
